  "pages": {
    "index.html": {
      "settings": {
        "main": true,
        "title": "Unity Game Developer Portfolio | Showcase Your Best Projects",
        "meta_descr": "Showcase your Unity game development skills with a professional portfolio. Highlight your best projects, demonstrating creativity and technical expertise to attract clients and employers.",
        "header_custom": "",
